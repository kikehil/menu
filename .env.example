# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_api_key_here
EVOLUTION_INSTANCE=mi-instancia

# SAT e.firma
SAT_RFC=XAXX010101000
SAT_EFIRMA_CER_PATH=/ruta/a/tu/efirma.cer
SAT_EFIRMA_KEY_PATH=/ruta/a/tu/efirma.key
SAT_EFIRMA_PASSWORD=tu_contraseña_efirma

# Números autorizados (separados por coma, sin espacios)
AUTHORIZED_NUMBERS=521234567890,529876543210

# Carpeta donde se guardan los PDFs
DOCUMENTS_PATH=./documents
